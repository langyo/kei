#!/bin/sh

# kei aarch64 initramfs entry point (PID 1) for CI.
# Serial-console variant of src/init_aarch64: no dropbear (the full
# dropbear rootfs is built by build_aarch64_rootfs.sh outside CI), just
# bring up the virtual filesystems and print the boot marker.

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null

echo ""
echo "=== kei ignition (aarch64) ==="
echo "Kernel booted successfully"
echo ""

echo "testing ls /proc"
ls /proc
echo "testing echo"
echo "hello from busybox"
echo "testing sleep"
sleep 1
echo "sleep done"
echo "testing mkdir"
mkdir /tmp/testdir
ls /tmp
echo "testing fork/exec loop"
i=0
while [ $i -lt 3 ]; do
  echo "loop iteration $i"
  i=$((i+1))
  sleep 1
done
echo "ALL TESTS DONE"
echo "Boot complete. Spawning shell on console."
if [ "$#" -eq 0 ]; then
    set -- /bin/sh
fi
exec "$@"
